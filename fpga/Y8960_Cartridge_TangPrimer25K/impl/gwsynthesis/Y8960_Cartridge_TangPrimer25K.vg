module jtopl_logsin (
  clk_42m,
  cenop_Z,
  aux_I,
  logsin_II
)
;
input clk_42m;
input cenop_Z;
input [7:0] aux_I;
output [11:0] logsin_II;
wire [31:12] DO;
wire VCC;
wire GND;
  pROM sinelut_sinelut_0_0_s (
    .DO({DO[31:12],logsin_II[11:0]}),
    .CLK(clk_42m),
    .CE(cenop_Z),
